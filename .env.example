# Bhet server
PORT=3000
DB_PATH=./data/bhet.sqlite
APP_URL=http://localhost:5173

# Self-hosted STUN/TURN (coturn shared-secret scheme)
TURN_SECRET=bhet-shared-turn-secret
TURN_REALM=bhet.local
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_CREDENTIAL_TTL_SECONDS=3600

# Optional: Groq API Key for fast multilingual Whisper Speech-to-Text
GROQ_API_KEY=
